# Kopiraj to datoteko v .env in vnesi svoje vrednosti.
# Datoteka .env se ne shrani v Git.

# Naključni skrivni ključ za podpis seje in zaščito obrazcev.
# Ustvariš ga z ukazom: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Povezava z MySQL bazo
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=solski_ikt
DB_USER=solski_ikt_app
DB_PASSWORD=

# --- Neobvezno (nadgradnje) ---
# Naslov aplikacije za povezave v e-poštnih obvestilih.
APP_URL=http://127.0.0.1:5000
# Poštni strežnik za obvestila. Če MAIL_SERVER ni nastavljen, se obvestila
# samo zabeležijo v bazo (vidna v meniju Obvestila) in se ne pošiljajo.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=ikt-pomocnik@sola.si
